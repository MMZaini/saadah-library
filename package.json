{
  "name": "saadah-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "next build",
    "copy:pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "start": "next start -p 3001",
    "lint": "eslint app components lib",
    "test": "vitest run",
    "test:data": "vitest run tests/data && yarn data:validate && yarn data:check-runtime",
    "data:import:github": "node scripts/data/import-github.mjs",
    "data:crawl": "node scripts/data/crawl-thaqalayn.mjs --dry-run",
    "data:update": "node scripts/data/crawl-thaqalayn.mjs --generate-release",
    "data:validate": "node scripts/data/validate.mjs",
    "data:check-runtime": "node scripts/data/check-runtime.mjs",
    "fix:check": "node scripts/check-fix-scope.mjs",
    "lint:fix": "eslint --fix app components lib",
    "format:check": "prettier --check \"{app,components,lib,scripts,tests}/**/*.{ts,tsx,js,jsx,mjs,json,css,md}\" \"*.{js,mjs,json,ts,md}\" \".github/workflows/*.{yml,yaml}\"",
    "format": "prettier --write \"{app,components,lib,scripts,tests}/**/*.{ts,tsx,js,jsx,mjs,json,css,md}\" \"*.{js,mjs,json,ts,md}\" \".github/workflows/*.{yml,yaml}\"",
    "fix": "yarn fix:check && yarn format && yarn lint:fix"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "^15.4.6",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.4.6",
    "eslint-config-prettier": "^10.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9"
  }
}
